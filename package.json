    "deploy": "npm run build:cloudflare && wrangler deploy",
    "preview": "node ./scripts/run-with-cloudflare-env.mjs astro preview",
    "wrangler:check": "wrangler deploy --dry-run",
    "astro": "astro"
  },
  "dependencies": {
