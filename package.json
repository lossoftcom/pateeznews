  "scripts": {
    "dev": "node ./scripts/run-with-cloudflare-env.mjs astro dev --host 127.0.0.1",
    "build": "npm run build:cloudflare",
    "build:astro": "node ./scripts/run-with-cloudflare-env.mjs astro build",
