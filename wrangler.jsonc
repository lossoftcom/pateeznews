{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pateeznews",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *", "*/30 * * * *"]
  },
  "dev": {
    "inspector_port": 0
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "68c47e07dd41448c9c2e914bd26803e5"
    }
  ],
  "vars": {
    "PATEEZ_ADMIN_API_DB_ROLE": "pateez_admin_api",
    "PATEEZ_AUTH_ISSUER": "https://pateez.com",
    "PUBLIC_SITE_URL": "https://pateez.com",
    "GOOGLE_WEB_CLIENT_ID": "219689188237-jprruujk8knn7noafs2nbvdgnuc67mbe.apps.googleusercontent.com",
    "GOOGLE_ANDROID_CLIENT_ID": "219689188237-bro0ndlr7s1t0m0c6erhfiag4dfguss7.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "219689188237-nujlogsppna6kq2g3m3vjdlp0gfgvgmj.apps.googleusercontent.com",
    "GOOGLE_CLIENT_IDS": "219689188237-jprruujk8knn7noafs2nbvdgnuc67mbe.apps.googleusercontent.com,219689188237-bro0ndlr7s1t0m0c6erhfiag4dfguss7.apps.googleusercontent.com,219689188237-nujlogsppna6kq2g3m3vjdlp0gfgvgmj.apps.googleusercontent.com",
    "PUBLIC_GOOGLE_WEB_CLIENT_ID": "219689188237-jprruujk8knn7noafs2nbvdgnuc67mbe.apps.googleusercontent.com",
    "APPLE_BUNDLE_ID": "com.pateez.app",
    "APPLE_SERVICE_ID": "com.pateez.pateezcom.web",
    "PUBLIC_APPLE_SERVICE_ID": "com.pateez.pateezcom.web",
    "FACEBOOK_APP_ID": "929495530098255",
    "PUBLIC_FACEBOOK_APP_ID": "929495530098255"
  }
}
