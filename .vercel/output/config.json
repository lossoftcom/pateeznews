{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/storage/file(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/haber/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/kategori/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/manifest\\.webmanifest/?$",
			"dest": "_render"
		},
		{
			"src": "^/profil/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/profil/?$",
			"dest": "_render"
		},
		{
			"src": "^/profil-duzenle/?$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt/?$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}