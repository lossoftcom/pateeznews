# Public build-time values. These can be visible in browser/client bundles.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side Cloudflare secrets. Set these with `wrangler secret put <NAME>`.
SUPABASE_SERVICE_ROLE_KEY=
MAIL_SECRET_KEY=

# Optional legacy HS256 JWT fallback. Not needed when Supabase exposes JWKS signing keys.
SUPABASE_JWT_SECRET=

# Local fallback only when the Cloudflare Hyperdrive binding is unavailable.
PATEEZ_ADMIN_API_DB_ROLE=pateez_admin_api
PATEEZ_ADMIN_API_DATABASE_URL=
SUPABASE_POOLER_DATABASE_URL=

# Local build/dev only: Wrangler uses this to emulate the HYPERDRIVE binding.
# Do not commit real connection strings.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
