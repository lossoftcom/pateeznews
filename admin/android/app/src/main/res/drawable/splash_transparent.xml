<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ sistem splash ikonunu görünmez kılmak için tamamen şeffaf drawable.
     Böylece cold start'ta launcher ikonu yerine sade beyaz ekran görünür ve
     Flutter'ın markalı açılış animasyonuna (PateezLogoIntro) kusursuz geçilir. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
