<mjml>
  <mj-head>
    <mj-title>Pateez.com · Giriş doğrulama kodu</mj-title>
    <mj-preview>Giriş doğrulama kodun {{dogrulama_kodu}}. {{kod_gecerlilik}} boyunca geçerli.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif" />
      <mj-text color="#536270" font-size="14px" line-height="1.7" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      @media only screen and (max-width:480px){ .pateez-code{ font-size:26px !important; letter-spacing:6px !important; } }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F2F4F7" width="600px">
    <mj-section padding="24px 16px 0"><mj-column><mj-text font-size="1px" line-height="1px" color="#F2F4F7">&nbsp;</mj-text></mj-column></mj-section>

    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-text font-size="1px" line-height="5px" color="#2C3E50" container-background-color="#2C3E50" padding="0">&nbsp;</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="30px 32px 8px">
      <mj-column>
        <mj-image src="__SITE_LOGO_URL__" alt="__SITE_NAME__" width="150px" align="center" padding="0"></mj-image>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="10px 36px 0">
      <mj-column>
        <mj-text align="center" font-size="11px" font-weight="800" color="#2C3E50" letter-spacing="1px" padding="0 0 10px">GİRİŞ DOĞRULAMA</mj-text>
        <mj-text align="center" font-size="25px" font-weight="800" color="#0F1B26" line-height="1.28" padding="0 0 12px">Girişini güvenle tamamla</mj-text>
        <mj-text align="center" color="#536270" padding="0">Merhaba <strong style="color:#2C3E50">{{uye_adi}}</strong>, Pateez.com hesabına giriş talebi aldık. Devam etmek için aşağıdaki kodu kullan.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px 38px 6px">
      <mj-column>
        <mj-text align="center" padding="0">
          <div style="background:#F1F3F5;border:1px solid #E6ECEE;border-left:5px solid #2C3E50;padding:18px 10px;border-radius:10px;">
            <span class="pateez-code" style="font-size:32px;line-height:1.1;letter-spacing:8px;font-weight:900;color:#2C3E50;font-family:Arial,sans-serif;">{{dogrulama_kodu}}</span>
          </div>
        </mj-text>
        <mj-text align="center" font-size="13px" color="#8A949B" padding="12px 0 0">Kod <strong style="color:#536270">{{kod_gecerlilik}}</strong> boyunca geçerlidir.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="18px 36px 0">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#536270" padding="0 0 16px">Bu giriş talebi sana ait değilse kodu kimseyle paylaşma ve hesabının güvenlik ayarlarını kontrol et.</mj-text>
        <mj-divider border-color="#F0F3F4" border-width="1px" padding="0"></mj-divider>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="16px 36px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8A949B" line-height="1.8">Yardım için <a href="mailto:__SUPPORT_EMAIL__" style="color:#2C3E50;text-decoration:none;font-weight:700;">__SUPPORT_EMAIL__</a> veya <a href="__CONTACT_URL__" style="color:#2C3E50;text-decoration:none;font-weight:700;">İletişim</a>.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="18px 24px 28px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8A949B" padding="0"><a href="__SITE_URL__" style="color:#8A949B;text-decoration:none;">__SITE_NAME__</a> · __COPYRIGHT_TEXT__</mj-text>
        <mj-text align="center" font-size="11px" color="#B6BFC4" padding="8px 0 0">Bu e-posta {{uye_eposta}} adresine gönderildi.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
