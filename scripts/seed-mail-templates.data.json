-color=\"#F0F3F4\" border-width=\"1px\" padding=\"0\"></mj-divider>\n      </mj-column>\n    </mj-section>\n\n    <mj-section background-color=\"#ffffff\" padding=\"16px 36px 32px\">\n      <mj-column>\n        <mj-text align=\"center\" font-size=\"12px\" color=\"#8A949B\" line-height=\"1.8\">Yardım için <a href=\"mailto:__SUPPORT_EMAIL__\" style=\"color:#F59E0B;text-decoration:none;font-weight:700;\">__SUPPORT_EMAIL__</a> veya <a href=\"__CONTACT_URL__\" style=\"color:#2C3E50;text-decoration:none;font-weight:700;\">İletişim</a>.</mj-text>\n      </mj-column>\n    </mj-section>\n\n    <mj-section padding=\"18px 24px 28px\">\n      <mj-column>\n        <mj-text align=\"center\" font-size=\"12px\" color=\"#8A949B\" padding=\"0\"><a href=\"__SITE_URL__\" style=\"color:#8A949B;text-decoration:none;\">__SITE_NAME__</a> · __COPYRIGHT_TEXT__</mj-text>\n        <mj-text align=\"center\" font-size=\"11px\" color=\"#B6BFC4\" padding=\"8px 0 0\">Bu e-posta {{uye_eposta}} adresine gönderildi.</mj-text>\n      </mj-column>\n    </mj-section>\n  </mj-body>\n</mjml>\n",
