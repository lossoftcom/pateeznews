---
import Layout from '@/layouts/Layout.astro';
import HomePage from '@/components/HomePage';
import { dataService } from '@/services/dataService.server';
import { loadLocaleData } from '@/lib/locales';
import { slugify } from '@/utils/helpers';
import { resolveLangCode } from '@/utils/lang';
import { getSpecialContentConfig } from '@/utils/specialContent';

const cookies = Astro.request.headers.get('cookie') || '';
const cookieLang = cookies.match(/pateez_lang=([^;]+)/)?.[1];
const activeCatCookieValue = cookies.match(/pateez_active_cat=([^;]+)/)?.[1];
const activeCatCookie = activeCatCookieValue ? decodeURIComponent(activeCatCookieValue) : null;
const acceptLanguageHeader = Astro.request.headers.get('accept-language');
const urlLang = Astro.url.searchParams.get('lang');
const urlCategory = Astro.url.searchParams.get('kategori');
const specialUrlCategory = getSpecialContentConfig(urlCategory);

// Get SEO alternates first to resolve language
const seoAlternates = await dataService.getSeoAlternates();
const defaultLangCode = seoAlternates.find((entry) => entry.isDefault)?.code || 'tr';
const lang = resolveLangCode({
  urlLang,
  cookieLang,
  acceptLanguageHeader,
  supported: seoAlternates.map((entry) => ({ code: entry.code, isDefault: entry.isDefault })),
  fallback: defaultLangCode,
});

const langMeta = seoAlternates.find((entry) => entry.code === lang);

// 🚀 LIGHT-SPEED PARALLEL FETCH (Everything in one go)
// Logic: If there's a category cookie, we fetch that specific category news directly in the parallel block.
const getNewsItemsForInitialLoad = async () => {
    if (specialUrlCategory) return dataService.getNewsItems(lang, specialUrlCategory.value);
    if (!activeCatCookie) return dataService.getNewsItems(lang);
    
    // Quick resolve nav items locally for broad filtering logic to avoid extra DB hit if possible, 
    // but since we need nav items anyway for the Layout, we'll just use the already fetched ones.
    // However, to keep it parallel, we need the logic here or just fetch general news and let client handle categorical switch.
    // For TRUE LIGHT SPEED SSR, we determine the category filters now.
    // We'll fetch nav items separately in the Promise.all and then decide, OR we can just fetch 'home' items
    // and let the client-side HomePage handle the category display if it's cached.
    // Actually, to avoid "double wait", we'll just fetch general news and handle categorical display on client.
    return dataService.getNewsItems(lang);
};

const [initialTranslations, siteSettings, navigationItems, newsItems, sidebarSnapshot] = await Promise.all([
  loadLocaleData(lang),
  dataService.getSiteSettings(lang),
  dataService.getNavigationItems(lang),
  getNewsItemsForInitialLoad(),
  dataService.getSidebarSnapshot(lang)
]);

// Determine selectedCategory for the UI
let selectedCategory: string | undefined = undefined;
if (specialUrlCategory) {
    selectedCategory = specialUrlCategory.value;
} else if (activeCatCookie) {
    const normalized = activeCatCookie.trim();
    const normalizedSlug = slugify(normalized);
    const navItem = navigationItems.find((item: any) =>
        item.value === normalized ||
        item.label === normalized ||
        (item.value && slugify(item.value) === normalizedSlug) ||
        slugify(item.label) === normalizedSlug
    );
    if (navItem && (!navItem.parent_id || navItem.parent_id === 'root')) {
        selectedCategory = normalized;
    }
}

const initialLang = {
  code: lang,
  name: langMeta?.name || lang.toUpperCase(),
  direction: langMeta?.direction || 'ltr',
  status: 'active',
  flag_code: langMeta?.flagCode || lang,
  is_default: langMeta?.isDefault || lang === defaultLangCode
};

const title = siteSettings?.home_title || siteSettings?.site_name || "Pateez News";
const description = siteSettings?.meta_description || "";
const ogImage = siteSettings?.og_image_url || "";

const canonicalBase = String(siteSettings?.canonical_url || Astro.url.origin).trim();
const TEXT_ENTITY_MAP: Record<string, string> = {
  amp: '&', apos: "'", Ccedil: 'Ç', ccedil: 'ç', Gbreve: 'Ğ', gbreve: 'ğ', hellip: '...',
  Idot: 'İ', imath: 'ı', laquo: '"', ldquo: '"', lsquo: "'", nbsp: ' ', Ouml: 'Ö',
  ouml: 'ö', quot: '"', raquo: '"', rdquo: '"', rsquo: "'", Scedil: 'Ş', scedil: 'ş',
  Uuml: 'Ü', uuml: 'ü',
};
const decodeTextCodePoint = (value: string, radix: number, fallback: string) => {
  const codePoint = Number.parseInt(value, radix);
  if (!Number.isFinite(codePoint) || codePoint <= 0) return fallback;
  try { return String.fromCodePoint(codePoint); } catch { return fallback; }
};
const decodeTextEntities = (value: string) => {
  const decodeOnce = (input: string) => input
    .replace(/&([a-zA-Z][a-zA-Z0-9]+);/g, (match, entity: string) => TEXT_ENTITY_MAP[entity] ?? match)
    .replace(/&#x([0-9a-fA-F]+);/g, (match, hex: string) => decodeTextCodePoint(hex, 16, match))
    .replace(/&#(\d+);/g, (match, decimal: string) => decodeTextCodePoint(decimal, 10, match));
  return decodeOnce(decodeOnce(value));
};
const stripHtml = (html: string) => decodeTextEntities((html || '').replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/g, ' '))
  .replace(/\s+/g, ' ')
  .trim();
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: (newsItems || []).slice(0, 10).map((item: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: stripHtml(String(item?.seoTitle || item?.title || '')),
    url: new URL(`/haber/${encodeURIComponent(String(item?.slug || item?.id || ''))}`, canonicalBase).toString(),
  })),
};

// 🎯 SSR IMAGE OPTIMIZATION REMOVED: 
// It was causing heavy blocking on server-side. 
// Standard NewsCard components will handle loading images reliably.
---

<Layout 
  title={title} 
  description={description} 
  ogImage={ogImage}
  jsonLd={itemListLd}
  favicon={siteSettings?.favicon_url}
  lang={lang}
  dir={initialLang.direction}
  siteSettings={siteSettings}
  navigationItems={navigationItems}
  initialTranslations={initialTranslations}
  initialLang={initialLang}
  seoAlternates={seoAlternates}
>
  <HomePage 
    client:load 
    initialLang={initialLang} 
    initialTranslations={initialTranslations}
    siteSettings={siteSettings}
    navigationItems={navigationItems}
    newsItems={newsItems}
    sidebarSnapshot={sidebarSnapshot}
    selectedCategory={selectedCategory}
    isInitialHome={true}
  />
</Layout>
