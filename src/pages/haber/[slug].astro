---
import Layout from '@/layouts/Layout.astro';
import NewsDetailPage from '@/components/NewsDetailPage';
import { dataService } from '@/services/dataService.server';
import { loadLocaleData } from '@/lib/locales';
import { setFreshPublicHtmlCache } from '@/lib/server/publicCache';
import { slugify } from '@/utils/helpers';
import { resolveLangCode } from '@/utils/lang';
import { getPostPathSegment } from '@/utils/postUrl';
import { getPublicAdSettings } from '@/lib/server/publicAds';

export const prerender = false;
setFreshPublicHtmlCache(Astro.response);

const { slug } = Astro.params;
const cookies = Astro.request.headers.get('cookie') || '';
const cookieLang = cookies.match(/pateez_lang=([^;]+)/)?.[1];
const acceptLanguageHeader = Astro.request.headers.get('accept-language');
const urlLang = Astro.url.searchParams.get('lang');

const seoAlternates = await dataService.getSeoAlternates();
const defaultLangCode = seoAlternates.find((entry) => entry.isDefault)?.code || 'tr';
const lang = resolveLangCode({
  urlLang,
  cookieLang,
  acceptLanguageHeader,
  supported: seoAlternates.map((entry) => ({ code: entry.code, isDefault: entry.isDefault })),
  fallback: defaultLangCode,
});

const langMeta = seoAlternates.find((entry) => entry.code === lang);

const [initialTranslations, siteSettings, navigationItems, newsItem, newsItems, sidebarSnapshot, adSettings] = await Promise.all([
  loadLocaleData(lang),
  dataService.getSiteSettings(lang),
  dataService.getNavigationItems(lang),
  dataService.getNewsBySlug(slug as string),
  dataService.getNewsItems(lang),
  dataService.getSidebarSnapshot(lang),
  getPublicAdSettings('web')
]);

const initialLang = {
  code: lang,
  name: langMeta?.name || lang.toUpperCase(),
  direction: langMeta?.direction || 'ltr',
  status: 'active',
  flag_code: langMeta?.flagCode || lang,
  is_default: langMeta?.isDefault || lang === defaultLangCode
};

if (!newsItem) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const title = newsItem.seoTitle || `${newsItem.title} | ${siteSettings?.site_name || 'Pateez'}`;
const description = newsItem.seoDescription || newsItem.summary;

const isLikelyImageUrl = (value: unknown) => {
  const raw = String(value || '').trim();
  return /\.(?:avif|webp|png|jpe?g|gif)(?:[?#].*)?$/i.test(raw);
};

const isLikelyVideoUrl = (value: unknown) => {
  const raw = String(value || '').trim();
  return /\.(?:mp4|webm|mov|m4v)(?:[?#].*)?$/i.test(raw) || /(?:youtube\.com|youtu\.be|vimeo\.com)/i.test(raw);
};

const ogImage = newsItem.thumbnail || newsItem.coverThumbnail || (isLikelyImageUrl(newsItem.mediaUrl) ? newsItem.mediaUrl : siteSettings?.og_image_url || "");
const ogVideo = isLikelyVideoUrl(newsItem.mediaUrl) ? newsItem.mediaUrl : "";

const canonicalBase = (siteSettings?.canonical_url || Astro.url.origin).trim();
const canonicalPathSegment = encodeURIComponent(getPostPathSegment(newsItem, siteSettings) || slug || newsItem.id);
const canonicalUrl = new URL(`/haber/${canonicalPathSegment}`, canonicalBase).toString();

const toAbsoluteUrl = (value: string | null | undefined) => {
  const raw = String(value || '').trim();
  if (!raw) return '';
  if (raw.startsWith('http://') || raw.startsWith('https://') || raw.startsWith('data:')) return raw;
  try {
    return new URL(raw, canonicalBase).toString();
  } catch {
    return raw;
  }
};

const TEXT_ENTITY_MAP: Record<string, string> = {
  amp: '&', apos: "'", Ccedil: 'Ç', ccedil: 'ç', Gbreve: 'Ğ', gbreve: 'ğ', hellip: '...',
  Idot: 'İ', imath: 'ı', laquo: '"', ldquo: '"', lsquo: "'", nbsp: ' ', Ouml: 'Ö',
  ouml: 'ö', quot: '"', raquo: '"', rdquo: '"', rsquo: "'", Scedil: 'Ş', scedil: 'ş',
  Uuml: 'Ü', uuml: 'ü',
};
const decodeTextCodePoint = (value: string, radix: number, fallback: string) => {
  const codePoint = Number.parseInt(value, radix);
  if (!Number.isFinite(codePoint) || codePoint <= 0) return fallback;
  try { return String.fromCodePoint(codePoint); } catch { return fallback; }
};
const decodeTextEntities = (value: string) => {
  const decodeOnce = (input: string) => input
    .replace(/&([a-zA-Z][a-zA-Z0-9]+);/g, (match, entity: string) => TEXT_ENTITY_MAP[entity] ?? match)
    .replace(/&#x([0-9a-fA-F]+);/g, (match, hex: string) => decodeTextCodePoint(hex, 16, match))
    .replace(/&#(\d+);/g, (match, decimal: string) => decodeTextCodePoint(decimal, 10, match));
  return decodeOnce(decodeOnce(value));
};
const stripHtml = (html: string) => decodeTextEntities((html || '').replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/g, ' '))
  .replace(/\s+/g, ' ')
  .trim();

const toIso = (value: string | null | undefined) => {
  const raw = String(value || '').trim();
  if (!raw) return undefined;
  const d = new Date(raw);
  if (Number.isNaN(d.getTime())) return undefined;
  return d.toISOString();
};

const articleSchemaTypes = new Set(['Article', 'NewsArticle', 'BlogPosting']);
const selectedSchemaType = String(newsItem.schemaType || '').trim();
const articleSchemaType = articleSchemaTypes.has(selectedSchemaType) ? selectedSchemaType : 'NewsArticle';
const authorProfileUrl = newsItem.publisherHandle
  ? new URL(`/profil/${encodeURIComponent(newsItem.publisherHandle)}`, canonicalBase).toString()
  : '';
const articleImage = toAbsoluteUrl(ogImage);
const isRecord = (value: unknown): value is Record<string, unknown> =>
  !!value && typeof value === 'object' && !Array.isArray(value);

const orgName = (siteSettings?.organization_legal_name || siteSettings?.site_name || 'Pateez').trim();
const orgLogo = toAbsoluteUrl(siteSettings?.logo_url || siteSettings?.favicon_url);
const orgUrl = new URL('/', canonicalBase).toString();
const factCheckData = isRecord(newsItem.factCheck) ? newsItem.factCheck : {};
const toSchemaHttpUrl = (value: unknown) => {
  const absolute = toAbsoluteUrl(String(value || ''));
  if (!absolute) return '';
  try {
    const parsed = new URL(absolute);
    return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.toString() : '';
  } catch {
    return '';
  }
};
const factCheckRatingNumber = (() => {
  const raw = Number(factCheckData.ratingValue);
  if (!Number.isFinite(raw)) return null;
  return Math.min(5, Math.max(1, Math.round(raw)));
})();
const factCheckRatingLabels: Record<string, Record<number, string>> = {
  tr: {
    1: 'Yanlış',
    2: 'Büyük ölçüde yanlış',
    3: 'Yarı doğru',
    4: 'Büyük ölçüde doğru',
    5: 'Doğru',
  },
  en: {
    1: 'False',
    2: 'Mostly false',
    3: 'Half true',
    4: 'Mostly true',
    5: 'True',
  },
  ar: {
    1: 'خاطئ',
    2: 'خاطئ إلى حد كبير',
    3: 'نصف صحيح',
    4: 'صحيح إلى حد كبير',
    5: 'صحيح',
  },
};
const factCheckRatingLabel = factCheckRatingNumber
  ? factCheckRatingLabels[lang]?.[factCheckRatingNumber] || factCheckRatingLabels.en[factCheckRatingNumber]
  : '';
const factCheckClaim = stripHtml(String(factCheckData.claimReviewed || ''));
const factCheckClaimAuthorName = stripHtml(String(factCheckData.claimAuthorName || ''));
const factCheckClaimAuthorUrl = toSchemaHttpUrl(factCheckData.claimAuthorUrl);
const factCheckClaimAppearanceUrl = toSchemaHttpUrl(factCheckData.claimAppearanceUrl);
const articleLd = {
  "@context": "https://schema.org",
  "@type": articleSchemaType,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  headline: stripHtml(newsItem.seoTitle || newsItem.title),
  description: stripHtml(newsItem.seoDescription || newsItem.summary),
  ...(articleImage ? { image: [articleImage] } : {}),
  ...(toIso(newsItem.timestamp) ? { datePublished: toIso(newsItem.timestamp) } : {}),
  ...(toIso(newsItem.modifiedAt || newsItem.timestamp) ? { dateModified: toIso(newsItem.modifiedAt || newsItem.timestamp) } : {}),
  ...(newsItem.category ? { articleSection: stripHtml(newsItem.category) } : {}),
  ...(newsItem.keywords ? { keywords: stripHtml(newsItem.keywords) } : {}),
  author: {
    "@type": "Person",
    name: stripHtml(newsItem.author || newsItem.source || orgName),
    ...(authorProfileUrl ? { url: authorProfileUrl } : {}),
  },
  publisher: {
    "@type": "Organization",
    name: orgName,
    ...(orgLogo ? { logo: { "@type": "ImageObject", url: orgLogo } } : {}),
  },
  ...(newsItem.factChecked ? {
    reviewedBy: {
      "@type": "Organization",
      name: orgName,
    },
  } : {}),
  inLanguage: lang,
  isAccessibleForFree: true,
};

const factCheckItemReviewed = factCheckClaimAuthorName || factCheckClaimAppearanceUrl ? {
  "@type": "Claim",
  ...(factCheckClaimAuthorName ? {
    author: {
      "@type": "Organization",
      name: factCheckClaimAuthorName,
      ...(factCheckClaimAuthorUrl ? { sameAs: factCheckClaimAuthorUrl } : {}),
    },
  } : {}),
  ...(factCheckClaimAppearanceUrl ? { appearance: factCheckClaimAppearanceUrl } : {}),
} : null;
const claimReviewLd = newsItem.factChecked && factCheckClaim && factCheckRatingNumber && factCheckRatingLabel ? {
  "@context": "https://schema.org",
  "@type": "ClaimReview",
  url: canonicalUrl,
  claimReviewed: factCheckClaim,
  ...(toIso(newsItem.timestamp) ? { datePublished: toIso(newsItem.timestamp) } : {}),
  author: {
    "@type": "Organization",
    name: orgName,
    url: orgUrl,
    ...(orgLogo ? { logo: { "@type": "ImageObject", url: orgLogo } } : {}),
  },
  reviewRating: {
    "@type": "Rating",
    ratingValue: factCheckRatingNumber,
    bestRating: 5,
    worstRating: 1,
    alternateName: factCheckRatingLabel,
  },
  ...(factCheckItemReviewed ? { itemReviewed: factCheckItemReviewed } : {}),
} : null;

const getItemType = (item: any) => String(item?.type || '').trim().toLowerCase();
const contentItems = Array.isArray(newsItem.items) ? newsItem.items : [];
const recipeItem = contentItems.find((item: any) => getItemType(item) === 'recipe');
const eventItem = contentItems.find((item: any) => getItemType(item) === 'event');
const videoItem = contentItems.find((item: any) => getItemType(item) === 'video');
const quizItem = contentItems.find((item: any) => getItemType(item) === 'quiz');

const recipeData = recipeItem?.recipeData || null;
const recipeLd = recipeData ? {
  "@context": "https://schema.org",
  "@type": "Recipe",
  mainEntityOfPage: canonicalUrl,
  name: stripHtml(recipeItem?.title || newsItem.title),
  description: stripHtml(recipeItem?.description || newsItem.summary),
  ...(articleImage ? { image: [articleImage] } : {}),
  ...(toIso(newsItem.timestamp) ? { datePublished: toIso(newsItem.timestamp) } : {}),
  ...(toIso(newsItem.modifiedAt || newsItem.timestamp) ? { dateModified: toIso(newsItem.modifiedAt || newsItem.timestamp) } : {}),
  author: articleLd.author,
  ...(recipeData.serving ? { recipeYield: stripHtml(String(recipeData.serving)) } : {}),
  ...(Array.isArray(recipeData.ingredients) ? {
    recipeIngredient: recipeData.ingredients
      .map((item: any) => stripHtml(String(item?.text || '')))
      .filter(Boolean),
  } : {}),
  ...(Array.isArray(recipeData.directions) ? {
    recipeInstructions: recipeData.directions
      .map((item: any) => {
        const text = stripHtml([item?.title, item?.content].filter(Boolean).join(' '));
        return text ? { "@type": "HowToStep", text } : null;
      })
      .filter(Boolean),
  } : {}),
} : null;

const eventData = eventItem?.eventData || null;
const eventStart = toIso(eventData?.startDateTime);
const eventLd = eventData && eventStart ? {
  "@context": "https://schema.org",
  "@type": "Event",
  name: stripHtml(eventItem?.title || newsItem.title),
  description: stripHtml(eventItem?.description || newsItem.summary),
  startDate: eventStart,
  ...(toIso(eventData?.endDateTime) ? { endDate: toIso(eventData?.endDateTime) } : {}),
  ...(articleImage ? { image: [articleImage] } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  ...(eventData.venueName || eventData.address ? {
    location: {
      "@type": "Place",
      name: stripHtml(String(eventData.venueName || '')),
      address: stripHtml(String(eventData.address || '')),
    },
  } : {}),
  ...(eventData.organizer ? {
    organizer: {
      "@type": "Organization",
      name: stripHtml(String(eventData.organizer)),
    },
  } : {}),
  ...(eventData.ticketUrl ? {
    offers: {
      "@type": "Offer",
      url: String(eventData.ticketUrl),
      availability: "https://schema.org/InStock",
      ...(eventData.ticketPrice ? { price: stripHtml(String(eventData.ticketPrice)) } : {}),
    },
  } : {}),
} : null;

const resolveVideoUrl = (value: unknown) => String(value || '').trim();
const videoUrl = resolveVideoUrl(videoItem?.mediaUrl || newsItem.mediaUrl);
const isEmbeddableVideo = /(?:youtube\.com|youtu\.be|vimeo\.com)/i.test(videoUrl);
const videoLd = videoUrl ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: stripHtml(videoItem?.title || newsItem.title),
  description: stripHtml(videoItem?.description || newsItem.summary),
  ...(articleImage ? { thumbnailUrl: [articleImage] } : {}),
  ...(toIso(newsItem.timestamp) ? { uploadDate: toIso(newsItem.timestamp) } : {}),
  ...(isEmbeddableVideo ? { embedUrl: videoUrl } : { contentUrl: videoUrl }),
} : null;

const quizLd = quizItem ? {
  "@context": "https://schema.org",
  "@type": "Quiz",
  name: stripHtml(quizItem?.title || newsItem.title),
  description: stripHtml(quizItem?.description || newsItem.summary),
  url: canonicalUrl,
} : null;

const categoryLabel = String(newsItem.category || '').trim();
const categorySlug = categoryLabel ? slugify(categoryLabel) : '';
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: siteSettings?.site_name || orgName || "Home",
    item: new URL('/', canonicalBase).toString(),
  },
  ...(categorySlug ? [{
    "@type": "ListItem",
    position: 2,
    name: stripHtml(categoryLabel),
    item: new URL(`/kategori/${encodeURIComponent(categorySlug)}`, canonicalBase).toString(),
  }] : []),
  {
    "@type": "ListItem",
    position: categorySlug ? 3 : 2,
    name: stripHtml(newsItem.seoTitle || newsItem.title),
    item: canonicalUrl,
  },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

const faqItems = Array.isArray(newsItem.faqData) ? newsItem.faqData.filter((f) => f?.q && f?.a) : [];
const faqLd = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((f) => ({
    "@type": "Question",
    name: stripHtml(String(f.q)),
    acceptedAnswer: {
      "@type": "Answer",
      text: stripHtml(String(f.a)),
    },
  })),
} : null;

const jsonLdItems = [articleLd, claimReviewLd, breadcrumbLd, recipeLd, eventLd, videoLd, quizLd, faqLd].filter(Boolean);
---

<Layout 
  title={title} 
  description={description} 
  keywords={newsItem.keywords}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={newsItem.thumbnailAlt || newsItem.seoTitle || newsItem.title}
  ogVideo={ogVideo}
  canonical={canonicalUrl}
  jsonLd={jsonLdItems}
  favicon={siteSettings?.favicon_url}
  lang={lang}
  dir={initialLang.direction}
  siteSettings={siteSettings}
  adSettings={adSettings}
  navigationItems={navigationItems}
  initialTranslations={initialTranslations}
  initialLang={initialLang}
  seoAlternates={seoAlternates}
>
  <NewsDetailPage 
    client:load
    initialLang={initialLang} 
    initialTranslations={initialTranslations}
    siteSettings={siteSettings}
    navigationItems={navigationItems}
    newsItem={newsItem as any}
    newsItems={newsItems}
    sidebarSnapshot={sidebarSnapshot}
    adSettings={adSettings}
  />
</Layout>
