---
import Layout from '@/layouts/Layout.astro';
import HomePage from '@/components/HomePage';
import { dataService } from '@/services/dataService.server';
import { loadLocaleData } from '@/lib/locales';
import { slugify } from '@/utils/helpers';
import { resolveLangCode } from '@/utils/lang';
import { getImage } from 'astro:assets';
import sharp from 'sharp';
import path from 'node:path';

export const prerender = false;

const { slug } = Astro.params;
const cookies = Astro.request.headers.get('cookie') || '';
const cookieLang = cookies.match(/pateez_lang=([^;]+)/)?.[1];
const acceptLanguageHeader = Astro.request.headers.get('accept-language');
const urlLang = Astro.url.searchParams.get('lang');

const seoAlternates = await dataService.getSeoAlternates();
const defaultLangCode = seoAlternates.find((entry) => entry.isDefault)?.code || 'tr';
const lang = resolveLangCode({
  urlLang,
  cookieLang,
  acceptLanguageHeader,
  supported: seoAlternates.map((entry) => ({ code: entry.code, isDefault: entry.isDefault })),
  fallback: defaultLangCode,
});

const langMeta = seoAlternates.find((entry) => entry.code === lang);

const [initialTranslations, siteSettings, navigationItems, storiesItems] = await Promise.all([
  loadLocaleData(lang),
  dataService.getSiteSettings(lang),
  dataService.getNavigationItems(lang),
  dataService.getStories(lang)
]);

const initialLang = {
  code: lang,
  name: langMeta?.name || lang.toUpperCase(),
  direction: langMeta?.direction || 'ltr',
  status: 'active',
  flag_code: langMeta?.flagCode || lang,
  is_default: langMeta?.isDefault || lang === defaultLangCode
};

const NORMAL_CATEGORY_LABELS: Record<string, string> = {
  spor: 'Spor',
};

const resolvedCategory = (() => {
  if (!slug) return null;
  const match = navigationItems.find((item) => item.value === slug || slugify(item.label) === slug || slugify(item.value) === slug);
  return match?.label || NORMAL_CATEGORY_LABELS[slugify(slug)] || slug;
})();

const CATEGORY_PAGE_SIZE = 12;
const categoryNewsPage = await dataService.getCategoryNewsPage(lang, resolvedCategory || '', CATEGORY_PAGE_SIZE, 0);
const newsItems = categoryNewsPage.items;

const title = `${resolvedCategory || slug} | ${siteSettings?.site_name || "Pateez News"}`;

const canonicalBase = String(siteSettings?.canonical_url || Astro.url.origin).trim();
const canonicalUrl = new URL(`/kategori/${encodeURIComponent(String(slug || ''))}`, canonicalBase).toString();

const TEXT_ENTITY_MAP: Record<string, string> = {
  amp: '&', apos: "'", Ccedil: 'Ç', ccedil: 'ç', Gbreve: 'Ğ', gbreve: 'ğ', hellip: '...',
  Idot: 'İ', imath: 'ı', laquo: '"', ldquo: '"', lsquo: "'", nbsp: ' ', Ouml: 'Ö',
  ouml: 'ö', quot: '"', raquo: '"', rdquo: '"', rsquo: "'", Scedil: 'Ş', scedil: 'ş',
  Uuml: 'Ü', uuml: 'ü',
};
const decodeTextCodePoint = (value: string, radix: number, fallback: string) => {
  const codePoint = Number.parseInt(value, radix);
  if (!Number.isFinite(codePoint) || codePoint <= 0) return fallback;
  try { return String.fromCodePoint(codePoint); } catch { return fallback; }
};
const decodeTextEntities = (value: string) => {
  const decodeOnce = (input: string) => input
    .replace(/&([a-zA-Z][a-zA-Z0-9]+);/g, (match, entity: string) => TEXT_ENTITY_MAP[entity] ?? match)
    .replace(/&#x([0-9a-fA-F]+);/g, (match, hex: string) => decodeTextCodePoint(hex, 16, match))
    .replace(/&#(\d+);/g, (match, decimal: string) => decodeTextCodePoint(decimal, 10, match));
  return decodeOnce(decodeOnce(value));
};
const stripHtml = (html: string) => decodeTextEntities((html || '').replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/g, ' '))
  .replace(/\s+/g, ' ')
  .trim();

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: siteSettings?.site_name || "Home",
      item: new URL('/', canonicalBase).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: stripHtml(String(resolvedCategory || slug || '')),
      item: canonicalUrl,
    },
  ],
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: (newsItems || []).slice(0, 10).map((item: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: stripHtml(String(item?.seoTitle || item?.title || '')),
    url: new URL(`/haber/${encodeURIComponent(String(item?.slug || item?.id || ''))}`, canonicalBase).toString(),
  })),
};

const THUMB_WIDTHS = [320, 480, 640, 840, 1280];
const THUMB_SIZES = '(max-width: 840px) 100vw, 840px';
const MAX_OPTIMIZED_ITEMS = 12;
const STORAGE_FILE_PREFIX = '/api/storage/file/';
const IMAGE_STORAGE_TYPES = new Set(['image', 'logo', 'profile']);

const resolveLocalStorageImage = (src: string) => {
  const raw = String(src || '').trim();
  if (!raw) return null;

  let pathname = raw;
  if (/^https?:\/\//i.test(raw)) {
    try {
      pathname = new URL(raw).pathname;
    } catch {
      return null;
    }
  }

  if (!pathname.startsWith(STORAGE_FILE_PREFIX)) return null;

  const relativePath = decodeURIComponent(pathname.slice(STORAGE_FILE_PREFIX.length));
  const [type, ...parts] = relativePath.split('/').filter(Boolean);
  if (!type || !IMAGE_STORAGE_TYPES.has(type) || parts.length === 0) return null;

  const baseDir = path.resolve(process.cwd(), 'Upload', type);
  const filePath = path.resolve(baseDir, ...parts);
  if (filePath !== baseDir && filePath.startsWith(`${baseDir}${path.sep}`)) return filePath;
  return null;
};

const readLocalImageDimensions = async (src: string) => {
  const filePath = resolveLocalStorageImage(src);
  if (!filePath) return null;

  try {
    const metadata = await sharp(filePath).metadata();
    const width = Number(metadata.width || 0);
    const height = Number(metadata.height || 0);
    if (width > 0 && height > 0) return { width, height };
  } catch {
    return null;
  }

  return null;
};

const buildOptimizedThumbnail = async (src: string) => {
  const raw = String(src || '').trim();
  if (!raw || raw.startsWith('data:')) return null;
  const dimensions = await readLocalImageDimensions(raw);
  try {
    const result = await getImage({ src: raw, widths: THUMB_WIDTHS, format: 'webp', quality: 'mid' });
    return {
      src: result.src,
      srcSet: result.srcSet.attribute,
      sizes: THUMB_SIZES,
      ...(dimensions || {}),
    };
  } catch {
    return dimensions ? { src: raw, ...dimensions } : null;
  }
};

const newsItemsWithOptimized = await Promise.all(
  (newsItems || []).map(async (item: any, index: number) => {
    if (index >= MAX_OPTIMIZED_ITEMS) return item;
    const optimizedThumbnail = await buildOptimizedThumbnail(item?.thumbnail);
    if (!optimizedThumbnail) return item;
    return { ...item, optimizedThumbnail };
  })
);
---

<Layout
  title={title}
  lang={lang}
  dir={initialLang.direction}
  favicon={siteSettings?.favicon_url}
  canonical={canonicalUrl}
  jsonLd={[breadcrumbLd, itemListLd]}
  siteSettings={siteSettings}
  navigationItems={navigationItems}
  initialTranslations={initialTranslations}
  initialLang={initialLang}
>
  <HomePage 
    client:idle 
    initialLang={initialLang} 
    initialTranslations={initialTranslations}
    siteSettings={siteSettings}
    navigationItems={navigationItems}
    newsItems={newsItemsWithOptimized}
    storiesItems={storiesItems}
    categoryPagination={{
      category: String(resolvedCategory || slug || ''),
      limit: categoryNewsPage.limit,
      nextOffset: categoryNewsPage.nextOffset,
      total: categoryNewsPage.total,
      totalViews: categoryNewsPage.totalViews,
      hasMore: categoryNewsPage.hasMore,
    }}
    selectedCategory={slug}
    isInitialHome={false}
  />
</Layout>
