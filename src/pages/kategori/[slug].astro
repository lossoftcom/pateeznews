---
import Layout from '@/layouts/Layout.astro';
import HomePage from '@/components/HomePage';
import { dataService } from '@/services/dataService.server';
import { loadLocaleData } from '@/lib/locales';
import { setPublicHtmlCache } from '@/lib/server/publicCache';
import { slugify } from '@/utils/helpers';
import { resolveLangCode } from '@/utils/lang';
import { getPostPathSegment } from '@/utils/postUrl';
import { getPublicAdSettings } from '@/lib/server/publicAds';

export const prerender = false;
setPublicHtmlCache(Astro.response);

const { slug } = Astro.params;
const cookies = Astro.request.headers.get('cookie') || '';
const cookieLang = cookies.match(/pateez_lang=([^;]+)/)?.[1];
const acceptLanguageHeader = Astro.request.headers.get('accept-language');
const urlLang = Astro.url.searchParams.get('lang');

const seoAlternates = await dataService.getSeoAlternates();
const defaultLangCode = seoAlternates.find((entry) => entry.isDefault)?.code || 'tr';
const lang = resolveLangCode({
  urlLang,
  cookieLang,
  acceptLanguageHeader,
  supported: seoAlternates.map((entry) => ({ code: entry.code, isDefault: entry.isDefault })),
  fallback: defaultLangCode,
});

const langMeta = seoAlternates.find((entry) => entry.code === lang);

const [initialTranslations, siteSettings, navigationItems, adSettings] = await Promise.all([
  loadLocaleData(lang),
  dataService.getSiteSettings(lang),
  dataService.getNavigationItems(lang),
  getPublicAdSettings('web')
]);

const initialLang = {
  code: lang,
  name: langMeta?.name || lang.toUpperCase(),
  direction: langMeta?.direction || 'ltr',
  status: 'active',
  flag_code: langMeta?.flagCode || lang,
  is_default: langMeta?.isDefault || lang === defaultLangCode
};

const NORMAL_CATEGORY_LABELS: Record<string, string> = {
  spor: 'Spor',
};

const WEEKLY_TREND_VALUES = new Set([
  'weekly_trends',
  'weekly_likes',
  'weekly_comments',
  'weekly_shares',
  'weekly_reads',
]);

const normalizeWeeklyTrendValue = (value: string) => {
  const normalized = String(value || '').trim().toLowerCase().replace(/-/g, '_');
  return WEEKLY_TREND_VALUES.has(normalized) ? normalized : '';
};

const resolveNavigationItem = (value: string) => {
  const normalizedSlug = slugify(value);
  return navigationItems.find((item) =>
    item.value === value ||
    item.label === value ||
    (item.value && slugify(item.value) === normalizedSlug) ||
    slugify(item.label) === normalizedSlug
  ) || null;
};

const activeNavigationItem = slug ? resolveNavigationItem(slug) : null;
const trendValue = normalizeWeeklyTrendValue(String(activeNavigationItem?.value || slug || ''));
const isTrendPage = activeNavigationItem?.type === 'trends' || !!trendValue;

const resolvedCategory = (() => {
  if (!slug) return null;
  if (activeNavigationItem) return activeNavigationItem.label || NORMAL_CATEGORY_LABELS[slugify(slug)] || slug;
  return NORMAL_CATEGORY_LABELS[slugify(slug)] || slug;
})();

const CATEGORY_PAGE_SIZE = 12;
const categoryNewsPage = isTrendPage
  ? await dataService.getWeeklyTrendNewsPage(lang, trendValue || 'weekly_trends', CATEGORY_PAGE_SIZE, 0)
  : await dataService.getCategoryNewsPage(lang, resolvedCategory || '', CATEGORY_PAGE_SIZE, 0);
const newsItems = categoryNewsPage.items;

const title = `${resolvedCategory || slug} | ${siteSettings?.site_name || "Pateez"}`;

const canonicalBase = String(siteSettings?.canonical_url || Astro.url.origin).trim();
const canonicalUrl = new URL(`/kategori/${encodeURIComponent(String(slug || ''))}`, canonicalBase).toString();

const TEXT_ENTITY_MAP: Record<string, string> = {
  amp: '&', apos: "'", Ccedil: 'Ç', ccedil: 'ç', Gbreve: 'Ğ', gbreve: 'ğ', hellip: '...',
  Idot: 'İ', imath: 'ı', laquo: '"', ldquo: '"', lsquo: "'", nbsp: ' ', Ouml: 'Ö',
  ouml: 'ö', quot: '"', raquo: '"', rdquo: '"', rsquo: "'", Scedil: 'Ş', scedil: 'ş',
  Uuml: 'Ü', uuml: 'ü',
};
const decodeTextCodePoint = (value: string, radix: number, fallback: string) => {
  const codePoint = Number.parseInt(value, radix);
  if (!Number.isFinite(codePoint) || codePoint <= 0) return fallback;
  try { return String.fromCodePoint(codePoint); } catch { return fallback; }
};
const decodeTextEntities = (value: string) => {
  const decodeOnce = (input: string) => input
    .replace(/&([a-zA-Z][a-zA-Z0-9]+);/g, (match, entity: string) => TEXT_ENTITY_MAP[entity] ?? match)
    .replace(/&#x([0-9a-fA-F]+);/g, (match, hex: string) => decodeTextCodePoint(hex, 16, match))
    .replace(/&#(\d+);/g, (match, decimal: string) => decodeTextCodePoint(decimal, 10, match));
  return decodeOnce(decodeOnce(value));
};
const stripHtml = (html: string) => decodeTextEntities((html || '').replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/g, ' '))
  .replace(/\s+/g, ' ')
  .trim();
const categorySummary = stripHtml(String(newsItems?.[0]?.seoDescription || newsItems?.[0]?.summary || ''));
const description = categorySummary
  ? categorySummary.slice(0, 160)
  : `${stripHtml(String(resolvedCategory || slug || ''))} haberleri ve son dakika gelişmeleri ${siteSettings?.site_name || 'Pateez'} üzerinde.`;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: siteSettings?.site_name || "Home",
      item: new URL('/', canonicalBase).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: stripHtml(String(resolvedCategory || slug || '')),
      item: canonicalUrl,
    },
  ],
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: (newsItems || []).slice(0, 10).map((item: any, index: number) => ({
    "@type": "ListItem",
    position: index + 1,
    name: stripHtml(String(item?.seoTitle || item?.title || '')),
    url: new URL(`/haber/${encodeURIComponent(getPostPathSegment(item, siteSettings) || '')}`, canonicalBase).toString(),
  })),
};

// Cloudflare Worker dev runtime cannot load native Sharp. Keep category pages on
// the same thumbnail path as the home page; card components handle image loading.
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={initialLang.direction}
  favicon={siteSettings?.favicon_url}
  canonical={canonicalUrl}
  jsonLd={[breadcrumbLd, itemListLd]}
  siteSettings={siteSettings}
  adSettings={adSettings}
  navigationItems={navigationItems}
  initialTranslations={initialTranslations}
  initialLang={initialLang}
>
  <HomePage 
    client:load 
    initialLang={initialLang} 
    initialTranslations={initialTranslations}
    siteSettings={siteSettings}
    adSettings={adSettings}
    navigationItems={navigationItems}
    newsItems={newsItems}
    categoryPagination={{
      category: String(resolvedCategory || slug || ''),
      limit: categoryNewsPage.limit,
      nextOffset: categoryNewsPage.nextOffset,
      total: categoryNewsPage.total,
      totalViews: categoryNewsPage.totalViews,
      hasMore: categoryNewsPage.hasMore,
    }}
    selectedCategory={slug}
    isInitialHome={false}
  />
</Layout>
