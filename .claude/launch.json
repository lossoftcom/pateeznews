{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "posta-builder",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8791", "--directory", "admin/assets/posta_builder"],
      "port": 8791
    },
    {
      "name": "web-stories",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "admin/web_stories_editor/node_modules/vite/bin/vite.js",
        "preview",
        "--outDir",
        "admin/assets/web_stories",
        "--host",
        "127.0.0.1",
        "--port",
        "8792",
        "--strictPort"
      ],
      "port": 8792
    },
    {
      "name": "web-stories-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "admin/web_stories_editor/node_modules/vite/bin/vite.js",
        "admin/web_stories_editor",
        "--host",
        "127.0.0.1",
        "--port",
        "5188",
        "--strictPort"
      ],
      "port": 5188
    }
  ]
}
